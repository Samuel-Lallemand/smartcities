from machine import Pin, PWM, ADC
from time import sleep

pot = ADC(Pin(26))
buzzer = PWM(Pin(27))

def jouer_note(frequence, duree):
    buzzer.freq(frequence)

    nb_repetitions = int(duree / 0.01)

    for _ in range(nb_repetitions):
        volume = pot.read_u16()
        buzzer.duty_u16(volume)
        sleep(0.01)

    buzzer.duty_u16(0)
    sleep(0)

