import machine
import utime

BOUTON = machine.Pin(16, machine.Pin.IN, machine.Pin.PULL_DOWN)
LED = machine.Pin(18, machine.Pin.OUT)

etat = 0
dernier_temps_bouton = 0

en_transition = False
debut_transition = 0

def bouton_interruption(pin):
    global etat, dernier_temps_bouton, en_transition, debut_transition
    temps_actuel = utime.ticks_ms()
    
    if not en_transition and utime.ticks_diff(temps_actuel, dernier_temps_bouton) > 200:
        dernier_temps_bouton = temps_actuel
        etat = (etat + 1) % 3 
        
        en_transition = True
        debut_transition = temps_actuel
        LED.value(1)

BOUTON.irq(trigger=machine.Pin.IRQ_RISING, handler=bouton_interruption)

dernier_changement_led = utime.ticks_ms()
etat_led = 0

while True:
    temps_actuel = utime.ticks_ms()
    
    if en_transition:
        LED.value(1)
        if utime.ticks_diff(temps_actuel, debut_transition) >= 5000:
            en_transition = False
            dernier_changement_led = temps_actuel
            etat_led = 1
            LED.value(1)
            
    else:
        if etat == 0:
            LED.value(0)
            etat_led = 0
            
        elif etat == 1:
            if utime.ticks_diff(temps_actuel, dernier_changement_led) >= 1000:
                dernier_changement_led = temps_actuel
                etat_led = 1 - etat_led
                LED.value(etat_led)
                
        elif etat == 2:
            if utime.ticks_diff(temps_actuel, dernier_changement_led) >= 250:
                dernier_changement_led = temps_actuel
                etat_led = 1 - etat_led
                LED.value(etat_led)

    utime.sleep_ms(10)
